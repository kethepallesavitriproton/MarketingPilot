# Copy this file to .env and enter your values locally. Never share .env.
# Keep local for normal local use; use a valid HTTPS origin before Meta authorization.
APP_BASE_URL=http://127.0.0.1:8000
APP_PASSWORD=
# Generate after installing requirements with: .venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SESSION_SECRET=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v23.0
# Optional. First enable Instagram API and its publishing permissions in your Meta app.
META_INSTAGRAM_ENABLED=0
# Leave blank to use APP_BASE_URL + /integrations/meta/callback.
META_REDIRECT_URI=
# After installing requirements, generate with:
# .venv\Scripts\python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
META_TOKEN_ENCRYPTION_KEY=
